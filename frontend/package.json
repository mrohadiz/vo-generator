{
  "name": "vo-generator-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:vendor": "pnpm --filter @fieldnote-ui/tokens build && pnpm --filter @fieldnote-ui/theme build && pnpm --filter @fieldnote-ui/icons build && pnpm --filter @fieldnote-ui/ui build && pnpm --filter @fieldnote-ui/layouts build && pnpm --filter @fieldnote-ui/charts build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fieldnote-ui/charts": "workspace:*",
    "@fieldnote-ui/icons": "workspace:*",
    "@fieldnote-ui/layouts": "workspace:*",
    "@fieldnote-ui/theme": "workspace:*",
    "@fieldnote-ui/tokens": "workspace:*",
    "@fieldnote-ui/ui": "workspace:*",
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource/jetbrains-mono": "^5.2.0",
    "@fontsource/source-serif-4": "^5.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.0.7"
  }
}
