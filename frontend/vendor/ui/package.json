{
  "name": "@fieldnote-ui/ui",
  "version": "0.1.0",
  "description": "FieldNote UI components for thinking: ObservationCard, EvidenceCard, InsightCard, DecisionCard, LearningCard and the knowledge primitives built on them.",
  "keywords": [
    "react",
    "components",
    "design-system",
    "decision-intelligence",
    "fieldnote-ui",
    "accessible"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/demoapp-maker/rohadi-themes.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && node scripts/copy-css.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:a11y": "vitest run src/__tests__/a11y.test.tsx",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fieldnote-ui/icons": "workspace:*",
    "@fieldnote-ui/theme": "workspace:*",
    "@fieldnote-ui/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "axe-core": "^4.14.0",
    "jsdom": "^26.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "@testing-library/jest-dom": "^7.0.1"
  }
}
