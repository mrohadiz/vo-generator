{
  "name": "@fieldnote-ui/tokens",
  "version": "0.1.0",
  "description": "Design tokens for FieldNote UI: colour, spacing, radius, shadow, typography, motion. Emits TypeScript, CSS variables and JSON.",
  "keywords": ["design-tokens", "design-system", "fieldnote-ui", "css-variables"],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./css": "./dist/variables.css",
    "./tokens.json": "./dist/tokens.json",
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/demoapp-maker/rohadi-themes.git",
    "directory": "packages/tokens"
  },
  "publishConfig": { "access": "public", "provenance": true },
  "scripts": {
    "build": "tsup && node scripts/build-css.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
