# Salin menjadi .env lalu isi. JANGAN komit .env.

# --- AI (mode teater, pemetaan ekspresi, alur video) ---
OMNIROUTE_KEY=
OMNIROUTE_ENDPOINT=https://ai-api.example.com/v1
# Opsional: model utama (default agy/gemini-3.8-flash-tiered) dan cadangan dipisah koma
# OMNIROUTE_PRIMARY_MODEL=
# OMNIROUTE_MODELS=auto/best-chat,auto/fast,auto/chat

# --- Gemini (cadangan AI langsung dan mesin Gemini TTS) ---
GEMINI_KEY=
# Opsional
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_TTS_RPM=4
# GEMINI_TTS_TEMPERATURE=0.8
# GEMINI_TTS_ROUTE=direct,omniroute

# --- Drama 3 (Space Hugging Face milik sendiri) ---
HF_TOKEN=
# DRAMA3_URL=https://NAMA-ANDA-drama-3.hf.space/

# --- B-roll video (Pixabay API resmi) ---
PIXABAY_API=
